<Window x:Class="HalimLabs.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:HalimLabs.Localization"
        Title="{Binding [SettingsTitle], Source={x:Static loc:Loc.Current}}"
        Height="700"
        Width="980"
        MinHeight="520"
        MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        Icon="pack://application:,,,/Resources/HalimLabs.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding [ImageModels], Source={x:Static loc:Loc.Current}}"
                           Style="{StaticResource SectionTitle}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [AddCustom], Source={x:Static loc:Loc.Current}}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding AddModelCommand}" ToolTip="{Binding [AddCustomTooltip], Source={x:Static loc:Loc.Current}}"/>
                <Button Content="+ FLUX" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding AddFluxCommand}"/>
                <Button Content="+ Kontext" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding AddKontextCommand}"/>
                <Button Content="+ Klein" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding AddKleinCommand}"/>
                <Button Content="+ Qwen" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding AddQwenCommand}"/>
                <Button Content="+ Qwen Local" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding AddQwenLocalCommand}"/>
                <Button Content="{Binding [Duplicate], Source={x:Static loc:Loc.Current}}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding DuplicateModelCommand}"/>
                <Button Content="{Binding [Remove], Source={x:Static loc:Loc.Current}}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding RemoveModelCommand}"/>
                <Button Content="{Binding [Test], Source={x:Static loc:Loc.Current}}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                        Command="{Binding TestConnectionCommand}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"/>
                <Button Content="{Binding [Save], Source={x:Static loc:Loc.Current}}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding [SettingsHint], Source={x:Static loc:Loc.Current}}"
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushKey}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,12,0"
                    Padding="6">
                <ListBox ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ProviderListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Model}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushKey}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedProfile}">
                        <TextBlock Text="{Binding [DisplayName], Source={x:Static loc:Loc.Current}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding [ApiKey], Source={x:Static loc:Loc.Current}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding [ApiMode], Source={x:Static loc:Loc.Current}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding DataContext.ApiModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding ApiMode}"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding [ApiBaseUrl], Source={x:Static loc:Loc.Current}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding [ModelId], Source={x:Static loc:Loc.Current}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding [Steps], Source={x:Static loc:Loc.Current}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding Steps, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="{Binding [CfgScale], Source={x:Static loc:Loc.Current}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding CfgScale, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding [Seed], Source={x:Static loc:Loc.Current}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding RandomSeed, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="{Binding [RandomSeed], Source={x:Static loc:Loc.Current}}"
                                  Style="{StaticResource DarkCheckBox}"
                                  IsChecked="{Binding RandomSeed}"
                                  Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.TestSuccess, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.TestSuccess, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DataContext.TestMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextWrapping="Wrap" MaxWidth="520"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <Button Content="{Binding [Close], Source={x:Static loc:Loc.Current}}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
